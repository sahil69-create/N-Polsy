ORCA_API_KEY=your_orcarouter_api_key_here
PORT=3000

# Model configuration
# Hosted model on OrcaRouter (Uncensored Qwen3.8 27B FP8 via Obsidian provider):
MODEL_NAME=obsidian/Qwen3.8-27B
# Alternative: if OrcaRouter provides a direct orcarouter/* model slug, use:
# MODEL_NAME=orcarouter/Qwen3.8-27B-Uncensored-FP8

ORCA_API_BASE_URL=https://api.orcarouter.ai/v1

# Model generation parameters
MAX_TOKENS=4096
TEMPERATURE=0.7

NODE_ENV=development
